<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <!-- 하드닝 런타임은 앱과 같은 Team ID로 서명된 라이브러리만 불러오게 한다.
         자체 서명 인증서에는 Team ID가 없어서 번들 안의 Sparkle.framework가
         "different Team IDs"로 거부되고 앱이 아예 뜨지 않는다. 검사를 끈다.

         Developer ID로 서명하게 되면 이 항목은 빼야 한다 — 그때는 Team ID가
         생기므로 검사가 통과하고, 켜 두는 편이 안전하다. -->
    <key>com.apple.security.cs.disable-library-validation</key>
    <true/>
</dict>
</plist>
